# Copy this file to .env (the local .env file is gitignored) before starting the backend.
# Generate each value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN_SECRET=
DEMO_USER_PASSWORD=

# Production blockchain signing keys are provided as environment secrets.
# Local Compose uses Hardhat's unlocked deterministic demo accounts when these are blank.
CHAIN_OPERATOR_PRIVATE_KEY=
CHAIN_SHIPPER_PRIVATE_KEY=
CHAIN_CARRIER_PRIVATE_KEY=

# MetaMask DApp: the server reads Sepolia; the user's wallet signs all DApp writes.
# Never put the user's seed phrase or MetaMask private key here.
DAPP_CHAIN_ID=11155111
DAPP_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DAPP_ORIGIN=http://localhost:5173

# Optional local overrides. The defaults match docker-compose.yml.
# POSTGRES_USER=chainroute
# POSTGRES_PASSWORD=chainroute-local
# POSTGRES_DB=chainroute
# POSTGRES_PORT=5432
