{
  "name": "chainroute-blockchain",
  "version": "0.1.0",
  "private": true,
  "description": "ChainRoute settlement and MetaMask freight receipt smart contracts",
  "scripts": {
    "node": "hardhat node --hostname 0.0.0.0",
