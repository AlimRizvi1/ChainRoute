    "test": "hardhat test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@openzeppelin/contracts": "^5.4.0",
    "ethers": "6.13.4",
    "hardhat": "2.22.17",
    "solc": "0.8.28"
  }
}
